# /etc/langhao/langhao.env — read by the langhao service (mode 0640, root:langhao).
# bootstrap-ec2.sh creates this file with a generated admin password; this is
# only a reference for what each setting does.

# Where leads and photos live. Absolute path, OUTSIDE /opt/langhao/releases,
# so deployments can never replace it. Required in production.
DATA_DIR=/var/lib/langhao

# Staff dashboard password, 12+ characters. There is no default: if this is
# missing the dashboard is disabled (the visitor form keeps working).
# Changing it signs every staff member out.
ADMIN_PASSWORD=

# Optional: refuse submissions / report unhealthy when the data volume has
# less than this many megabytes free (default 1024).
# MIN_FREE_DISK_MB=1024

# Optional: also copy each backup to S3 (needs the aws CLI and an instance role).
# BACKUP_S3_URI=s3://your-bucket/langhao-backups
