# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# From the Supabase dashboard: Project Settings → API.

# Safe to expose to the browser — the public form uses this to submit leads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_. Used by the admin dashboard
# to read/update leads and to view uploaded photos. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for staff to view /admin. Anything you like.
ADMIN_PASSWORD=
